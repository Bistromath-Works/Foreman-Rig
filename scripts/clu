#!/usr/bin/env bash
# CLU: the audit that reads the lessons ledger and proposes one change to the rulebook.
#
#   scripts/clu rulebook                         the rulebook's files, their size and the cap
#   scripts/clu audit <project> [--model <id>]   read the project's ledger, write one proposal (or none)
#   scripts/clu show <proposal.json>             print a proposal and its checks
#
# CLU sits outside both rigs. It proposes and never merges: a proposal is a file under
# clu/proposals/ with a patch beside it, for the human to read and turn into a pull request.
#
# What leaves the machine: the lessons (one sentence each, no code) and the rulebook's text.
# The ledger is scanned for anything that looks like a key first, and the audit refuses to run
# if it finds one. The model is asked through OpenRouter (OPENROUTER_API_KEY).
#
# The model's answer is checked in code before it becomes a proposal:
#   - the habit must appear in three or more different jobs, all of them in the ledger
#   - the change must replace text that occurs exactly once in one rulebook file
#   - the new text may not have more lines than the text it replaces (the rulebook does not grow)
#   - one proposal per audit
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RULEBOOK="$ROOT/rulebook.json"
OUT="${CLU_OUT:-$ROOT/clu/proposals}"
CLU_URL="${CLU_URL:-https://openrouter.ai/api/v1/chat/completions}"
CLU_MODEL="${CLU_MODEL:-z-ai/glm-5.3}"
MIN_JOBS=3
# Shapes of things that must never be sent out: common key prefixes, long hex or base64 runs,
# private key blocks, and "password=" style pairs whose value is one unbroken run of 16 or more
# key-like characters (so "the token: subsequent requests..." in a lesson is not a hit).
SECRET_RE='(sk-[A-Za-z0-9_-]{16,}|[sr]k_(live|test)_[A-Za-z0-9]{8,}|pk_(live|test)_[A-Za-z0-9]{8,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{30,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY|[A-Fa-f0-9]{40,}|[A-Za-z0-9+/]{48,}={0,2}|(password|passwd|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_+/.=-]{16,})'

die() { printf 'clu: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }
usage() { sed -n '3,6p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
files() { jq -r '.files[]' "$RULEBOOK"; }

cmd_rulebook() {
  local f n total=0 max
  max="$(jq -r .max_lines "$RULEBOOK")"
  while IFS= read -r f; do
    [ -f "$ROOT/$f" ] || die "rulebook file missing: $f"
    n="$(wc -l <"$ROOT/$f" | tr -d ' ')"; total=$((total + n)); printf '%5d  %s\n' "$n" "$f"
  done < <(files)
  printf '%5d  total (cap %s)\n' "$total" "$max"
  [ "$total" -le "$max" ] || die "the rulebook is $((total - max)) lines over its cap of $max. A new rule replaces or merges with an old one."
  # The lines that must survive any rewording. Text is matched across line breaks.
  local lost=""
  while IFS=$'\t' read -r f n; do
    jq -e --rawfile t "$ROOT/$f" --arg f "$f" --argjson n "$n" '.must_keep[$f][$n] as $k | ($t | gsub("\\s+"; " ")) | contains($k | gsub("\\s+"; " "))' "$RULEBOOK" >/dev/null \
      || lost="$lost
  $f: $(jq -r --arg f "$f" --argjson n "$n" '.must_keep[$f][$n]' "$RULEBOOK")"
  done < <(jq -r '.must_keep // {} | to_entries[] | .key as $f | .value | keys[] | [$f, .] | @tsv' "$RULEBOOK")
  [ -z "$lost" ] || die "the rulebook has lost a line it must keep:$lost
If the change is meant, change must_keep in rulebook.json in the same commit."
  printf '%5d  must-keep lines, all present\n' "$(jq '[.must_keep // {} | .[] | length] | add // 0' "$RULEBOOK")"
}

cmd_audit() {
  local project="" arg ledger
  while [ $# -gt 0 ]; do
    case "$1" in --model) CLU_MODEL="${2:-}"; [ -n "$CLU_MODEL" ] || die "--model needs a model id"; shift ;; -*) die "unknown option $1" ;; *) project="$1" ;; esac; shift
  done
  [ -n "$project" ] && [ -d "$project" ] || usage
  ledger="$project/.foreman/habits.jsonl"
  [ -s "$ledger" ] || die "no lessons yet in $ledger"
  # One copy is taken and everything below reads that copy: what is scanned is what is sent.
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT   # not local: the trap runs after the function returns
  cp "$ledger" "$tmp/ledger.jsonl"; ledger="$tmp/ledger.jsonl"
  jq -e . "$ledger" >/dev/null 2>&1 || die "$project/.foreman/habits.jsonl has a line that is not JSON"
  # Scanned twice: as written, and with every text field decoded (in the file a quote inside a
  # lesson is written \", which would hide password="..." from the pattern).
  local hit
  hit="$({ grep -Ein -- "$SECRET_RE" "$ledger" | cut -d: -f1; jq -r 'input_line_number as $n | [.. | strings][] | gsub("\n"; " ") | "\($n)\t\(.)"' "$ledger" | grep -Ei -- "$SECRET_RE" | cut -f1; } | head -1)" || true
  [ -z "$hit" ] || die "the ledger holds something that looks like a key or secret (line $hit). Nothing was sent. Remove it and run again."
  [ -n "${OPENROUTER_API_KEY:-}" ] || die "OPENROUTER_API_KEY is not set"
  cmd_rulebook >/dev/null

  local jobs; jobs="$(jq -r .job "$ledger" | sort -u | wc -l | tr -d ' ')"
  { while IFS= read -r f; do printf '\n===== FILE: %s =====\n' "$f"; cat "$ROOT/$f"; done < <(files); } >"$tmp/rulebook.txt"
  jq -c '{job, about, lesson}' "$ledger" >"$tmp/lessons.jsonl"

  jq -n --arg m "$CLU_MODEL" --rawfile rb "$tmp/rulebook.txt" --rawfile ls "$tmp/lessons.jsonl" --argjson min "$MIN_JOBS" '
    {model:$m, temperature:0, response_format:{type:"json_object"},
     messages:[
       {role:"system", content:("You audit a small software crew of AI agents. After every job the crew logs up to three lessons: one-sentence habits it saw, each tagged with the job and the seat it is about. You are given the lessons ledger and the rulebook (the instruction files the seats are given). Your job is to find habits that keep coming back and, at most, propose ONE change to the rulebook.\n\nRules you must follow:\n1. A habit counts only if it appears in \($min) or more DIFFERENT jobs. Lessons that say the same thing in different words are the same habit.\n2. Prefer a check in code to a rule in a prompt. If a program could catch the habit exactly (a test, a lint rule, a gate), do not propose a rulebook change for it: list it under checks instead.\n3. Propose at most one rulebook change, for the recurring habit that costs the most. If nothing recurs \($min) times, or every recurring habit is better as a check, the proposal is null.\n4. A change replaces existing text. old_text must be copied EXACTLY, character for character, from one rulebook file, and must be a passage that occurs only once in that file. new_text replaces it and must not have more lines than old_text: merge or sharpen an existing rule, never add to the total.\n5. Never include code, names of people or customers, or anything that looks like a key.\n\nAnswer with one JSON object and nothing else:\n{\"habits\":[{\"habit\":\"one sentence\",\"about\":\"seat\",\"jobs\":[\"job ids\"]}],\n \"checks\":[{\"habit\":\"one sentence\",\"check\":\"what a program would check\"}],\n \"proposal\":null or {\"file\":\"path as given in the FILE header\",\"old_text\":\"...\",\"new_text\":\"...\",\"habit\":\"the habit this corrects\",\"jobs\":[\"job ids where it was seen\"],\"reason\":\"one or two sentences\"}}")},
       {role:"user", content:("LESSONS LEDGER (one JSON object per line):\n" + $ls + "\n\nRULEBOOK:\n" + $rb)}]}' >"$tmp/body.json"

  local http
  http="$(printf 'header = "Authorization: Bearer %s"\n' "$OPENROUTER_API_KEY" \
    | curl -sS --max-time 180 --config - -o "$tmp/resp.json" -w '%{http_code}' \
        -H 'Content-Type: application/json' -H 'User-Agent: foreman-clu/1' \
        --data-binary "@$tmp/body.json" "$CLU_URL" 2>"$tmp/curl.err")" || die "request failed: $(head -c 200 "$tmp/curl.err" | tr '\n' ' ')"
  [ "$http" = 200 ] || die "the model service answered HTTP $http: $(head -c 200 "$tmp/resp.json" | tr '\n' ' ')"
  jq -r '.choices[0].message.content // ""' "$tmp/resp.json" | sed -e '1s/^```json[[:space:]]*$//' -e '1s/^```[[:space:]]*$//' -e '$s/^```[[:space:]]*$//' >"$tmp/answer.json"
  # Exactly one JSON object, and that same object is what gets checked, stored and patched.
  jq -es 'length == 1 and (.[0] | type == "object" and has("proposal"))' "$tmp/answer.json" >/dev/null 2>&1 \
    || die "the model's answer was not the one JSON object asked for; nothing was written"
  jq -s '.[0]' "$tmp/answer.json" >"$tmp/answer1.json" && mv "$tmp/answer1.json" "$tmp/answer.json"

  # Every claim in the answer is checked here. A proposal that fails a check is kept, marked
  # rejected with the reason, so the bake-off can count how often each model gets it wrong.
  local problems=() file old new n
  if jq -e '.proposal == null' "$tmp/answer.json" >/dev/null; then :; else
    jq -e '.proposal | type == "object" and (.file|type)=="string" and (.old_text|type)=="string" and (.new_text|type)=="string" and (.habit|type)=="string"
           and (.jobs|type)=="array" and (.jobs | all(.[]; type == "string" and (gsub("\\s"; "") | length) > 0))' "$tmp/answer.json" >/dev/null \
      || problems+=("the proposal is missing a field, or its jobs are not a list of job ids (a blank id is not one)")
    if [ "${#problems[@]}" -eq 0 ]; then
      file="$(jq -r .proposal.file "$tmp/answer.json")"
      files | grep -qxF "$file" || problems+=("'$file' is not a rulebook file")
      n="$(jq -r --slurpfile l <(jq -cs '[.[].job] | unique' "$ledger") '[.proposal.jobs | unique[] | select(. as $j | $l[0] | index($j) | not)] | if length == 0 then "" else "\(length): " + (map("\"" + . + "\"") | join(", ")) end' "$tmp/answer.json")"
      [ -z "$n" ] || problems+=("it names job(s) that are not in the ledger, $n")
      n="$(jq -r '.proposal.jobs | unique | length' "$tmp/answer.json")"
      [ "$n" -ge "$MIN_JOBS" ] || problems+=("the habit is tied to $n job(s) in the ledger; it needs $MIN_JOBS")
      if [ -f "$ROOT/$file" ] && files | grep -qxF "$file"; then
        n="$(jq -r --rawfile f "$ROOT/$file" '.proposal.old_text as $o | if ($o | length) == 0 then 0 else ($f | split($o) | length - 1) end' "$tmp/answer.json")"
        [ "$n" -eq 1 ] || problems+=("old_text occurs $n time(s) in $file; it must occur exactly once")
      fi
      jq -e '.proposal | .new_text != .old_text' "$tmp/answer.json" >/dev/null || problems+=("new_text is the same as old_text; the proposal changes nothing")
      # Counted on the file as it would be after the change, so a stray newline cannot add a line.
      if [ "${#problems[@]}" -eq 0 ]; then
        jq -rj --rawfile f "$ROOT/$file" '.proposal as $p | ($f | split($p.old_text)) as $parts | $parts[0] + $p.new_text + $parts[1]' "$tmp/answer.json" >"$tmp/after"
        [ "$(wc -l <"$tmp/after")" -le "$(wc -l <"$ROOT/$file")" ] || problems+=("the file would have more lines after the change; the rulebook may not grow")
        # The same must-keep check as `clu rulebook`, on the file as it would be.
        n="$(jq -r --rawfile t "$tmp/after" --arg f "$file" '($t | gsub("\\s+"; " ")) as $t | [.must_keep[$f] // [] | .[] | select(. as $k | $t | contains($k | gsub("\\s+"; " ")) | not)] | join(" | ")' "$RULEBOOK")"
        [ -z "$n" ] || problems+=("the change would remove a line the rulebook must keep: $n")
      fi
      ! jq -r '.proposal.new_text' "$tmp/answer.json" | grep -Eiq -- "$SECRET_RE" || problems+=("new_text holds something that looks like a key")
    fi
  fi

  mkdir -p "$OUT"
  local stamp slug rec patch
  stamp="$(date -u +%Y%m%d-%H%M%S)"; slug="$(printf '%s' "$CLU_MODEL" | tr -c 'A-Za-z0-9.-' '_')"
  rec="$OUT/$stamp-$slug.json"; n=1
  # Never reuse a name. The record is created empty here, and creating a file that already
  # exists fails, so two audits started in the same second cannot both take one name.
  while [ -e "${rec%.json}.patch" ] || ! ( set -o noclobber; : >"$rec" ) 2>/dev/null; do
    n=$((n+1)); rec="$OUT/$stamp-$slug-$n.json"; [ "$n" -lt 1000 ] || die "cannot create a record in $OUT"
  done
  patch="${rec%.json}.patch"
  jq -n --slurpfile a "$tmp/answer.json" --arg m "$CLU_MODEL" --arg at "$(date -u +%FT%TZ)" --arg p "$project" \
        --argjson lessons "$(wc -l <"$ledger" | tr -d ' ')" --argjson jobs "$jobs" --args \
    '{at:$at, model:$m, project:($p | split("/") | last), lessons:$lessons, jobs:$jobs,
      status:(if $a[0].proposal == null then "no proposal" elif ($ARGS.positional | length) > 0 then "rejected" else "proposed" end),
      problems:$ARGS.positional, habits:($a[0].habits // []), checks:($a[0].checks // []), proposal:$a[0].proposal}' "${problems[@]}" >"$rec"
  if [ "$(jq -r .status "$rec")" = proposed ]; then
    file="$(jq -r .proposal.file "$rec")"; mkdir -p "$tmp/a/$(dirname "$file")" "$tmp/b/$(dirname "$file")"
    cp "$ROOT/$file" "$tmp/a/$file"
    jq -rj --rawfile f "$ROOT/$file" '.proposal as $p | ($f | split($p.old_text)) as $parts | $parts[0] + $p.new_text + $parts[1]' "$rec" >"$tmp/b/$file"
    local drc=0
    ( cd "$tmp" && diff -u "a/$file" "b/$file" >"$patch" ) || drc=$?
    [ "$drc" -eq 1 ] || { rm -f "$patch"; die "could not make a patch for the proposal (diff exit $drc); the record is $rec"; }
  fi
  cmd_show "$rec"
}

cmd_show() {
  local rec="${1:-}"; [ -f "$rec" ] || usage
  jq -r '"CLU audit by \(.model) on \(.at[0:10]): \(.lessons) lessons from \(.jobs) jobs (\(.project))",
         "",
         "habits it saw:",
         (.habits[]? | objects | "  - [\(.about // "?" | tostring)] \(.habit | tostring)  (jobs: \(try ((.jobs // []) | map(tostring) | join(", ")) catch "?"))"),
         (if (.checks | length) > 0 then "better as a check in code:", (.checks[] | objects | "  - \(.habit | tostring) -> \(.check | tostring)") else empty end),
         "",
         "result: \(.status | ascii_upcase)",
         (.problems[]? | "  rejected because: \(.)"),
         (if (.proposal | type) == "object" then "  file:   \(.proposal.file | tostring)", "  habit:  \(.proposal.habit | tostring)", "  seen in: \(try ((.proposal.jobs // []) | map(tostring) | join(", ")) catch "?")", "  reason: \(.proposal.reason // "" | tostring)" else empty end)' "$rec"
  [ ! -f "${rec%.json}.patch" ] || { say ""; cat "${rec%.json}.patch"; say ""; say "This is a proposal. Nothing was changed. To take it: apply the patch on a branch and open a pull request for the human."; }
  say "record: $rec"
}

case "${1:-}" in
  rulebook) shift; cmd_rulebook "$@" ;;
  audit) shift; cmd_audit "$@" ;;
  show) shift; cmd_show "$@" ;;
  *) usage ;;
esac
