#!/usr/bin/env bash
# Foreman's command guard. A seat's runtime calls this before it runs a shell command; a banned
# command is refused before it starts, whatever the seat's prompt says.
#
#   foreman-guard <bans.json>              hook mode: the tool call arrives as JSON on stdin
#   foreman-guard <bans.json> --command    the command itself arrives on stdin (used by Pi)
#
# Exit 0: allowed. Exit 2: refused, with the reason on stderr (Claude Code and Codex both read
# exit 2 from a PreToolUse hook as "block, and show the model the reason").
#
# The ban list is written by `scripts/foreman bans <project>` from the project's banned_cmds and
# Foreman's built-in bans. A ban matches when its text appears in the command as whole words
# ("vercel" matches `npx vercel deploy`, not `cat vercel.json`). A ban marked "anywhere" matches
# wherever its text appears, part of a path included. A ban with "unless" words is lifted only
# when every command in the line that holds the text also has those words. If the list cannot be read,
# every shell command is refused: a guard that fails open is no guard.
#
# This stops a seat that forgets or misreads a rule. It does not stop one that sets out to get
# round it (a script, a renamed binary). What makes push impossible is the lack of credentials.
set -uo pipefail

bans="${1:-}"; mode="${2:-}"
refuse() { printf 'Blocked by Foreman: %s\n' "$*" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || refuse "the guard needs jq and cannot find it, so no shell command can run. Tell the human."
# Exactly one JSON object with a list of bans. Two objects in the file would leave the second unread.
[ -r "$bans" ] && jq -es 'length == 1 and (.[0].bans | type == "array")' "$bans" >/dev/null 2>&1 \
  || refuse "the ban list ($bans) is missing or unreadable, so no shell command can run. Tell the human; they run: scripts/foreman bans <project>"

input="$(cat)"
if [ "$mode" = --command ]; then
  cmd="$input"; bg=false
else
  # Only shell tools carry a command. Anything else (file reads, edits) is not this guard's job.
  cmd="$(jq -r 'if (.tool_input | type) == "object" then (.tool_input.command // empty | if type == "array" then join(" ") else tostring end) else empty end' <<<"$input" 2>/dev/null)" \
    || refuse "could not read the tool call, so the command was not run. Tell the human."
  bg="$(jq -r '.tool_input.run_in_background // false' <<<"$input" 2>/dev/null || echo false)"
  [ -n "$cmd" ] || exit 0
fi

# The matching rules, in jq. A ban's text must appear as whole words: not glued to a letter,
# digit or _ before it, and followed by the end, a space, or a shell separator.
# The command is read the way a shell splits it: into words (quotes and backslashes understood)
# and operators. Nothing is run or expanded.
read -r -d '' MATCH <<'JQ' || true
def esc: gsub("(?<c>[\\\\^$.|?*+()\\[\\]{}])"; "\\\\\(.c)");
def has($c; $t): $c | test("(^|[^A-Za-z0-9_])" + ($t | esc) + "($|[\\s;|&<>)\"'`=])");
# Tokens: a word (with its quotes), a line end, a run of ; | & ( ), or a redirection.
def toks: [match("(?:[^\\s\"'\\\\;|&<>()]|\\\\[\\s\\S]|\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"|'[^']*')+|\\n|[;|&()]+|[<>]+&?"; "g").string];
def isop: test("^(\\n|[;|&()]+)$");
def isredir: test("^[<>]+&?$");
# A word as the program would receive it: quotes and backslashes taken off.
def unq: gsub("\"(?<d>(\\\\[\\s\\S]|[^\"\\\\])*)\"|'(?<s>[^']*)'|\\\\(?<e>[\\s\\S])";
              if .d != null then (.d | gsub("\\\\(?<c>[\\s\\S])"; .c)) elif .s != null then .s else (.e // "") end);
# The commands of a line: the words between operators, without redirections and their targets.
def cmds: reduce toks[] as $t ([[]]; if ($t | isop) then . + [[]] else .[-1] += [$t] end)
  | map(select(length > 0) | . as $a
        | [range(0; length) | select(($a[.] | isredir | not) and (. == 0 or ($a[. - 1] | isredir | not))) | $a[.] | unq]);
# git's own options before the subcommand are dropped, so `git -C "My App" push` reads as git push.
def nogit: . as $w
  | reduce range(0; length) as $i ({out: [], skip: 0, git: false};
      if .skip > 0 then .skip -= 1
      elif .git and (["-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path", "--config-env"] | index($w[$i])) != null then .skip = 1
      elif .git and ((["--no-pager", "--paginate", "-p", "-P", "--bare", "--no-replace-objects", "--literal-pathspecs", "--no-optional-locks"] | index($w[$i])) != null
                     or ($w[$i] | test("^--(git-dir|work-tree|namespace|exec-path|config-env)="))) then .
      else .git = ($w[$i] | test("(^|/)git$")) | .out += [$w[$i]] end)
  | .out;
# A here-document's text (<<EOF ... EOF) is a file being written. For the background check it
# is cut out (up to three per command); the rest of the line that opens it stays.
def nodoc: gsub("<<-?[ \\t]*['\"]?(?<w>[A-Za-z_][A-Za-z0-9_]*)['\"]?(?<rest>[^\\n]*)\\n(?:[\\s\\S]*?\\n)??[ \\t]*\\k<w>(?=\\n|$)"; "<<-HEREDOC\(.rest)");
# Does the text start something in the background? A lone & that is an operator (not &&, |&,
# &> or one inside quotes), a nohup/setsid/disown word, or the same inside a script handed to a
# shell with -c.
def bg: . as $s
  | ($s | toks) as $a
  | any(range(0; $a | length); ($a[.] | (isop and test("(^|[^&|])&($|[^&])"))) and (($a[. + 1] // "") | test("^>") | not))
    or any($s | cmds[]; . as $w
         | any($w[]; test("^(nohup|setsid|disown)$"))
           or any(range(1; $w | length); ($w[.] | test("^-[a-z]*c$")) and any($w[0:.][]; test("(^|/)(bash|sh|zsh|dash)$")) and (($w[. + 1] // "") | bg)));
# A backslash at a line end joins the lines, as the shell does. $raw is the command as typed
# with line ends closing a command and spaces squeezed; $cs is each command as its words.
($cmd | gsub("\\\\\\n"; "")) as $src
| ($src | gsub("\\s*\\n\\s*"; " ; ") | gsub("\\s+"; " ")) as $raw
| [$src | cmds[] | nogit | {w: ., s: (join(" ") | gsub("\\s+"; " "))}] as $cs
| ([$cs[].s] | join(" ; ")) as $plain
# Every command that holds the banned text: its words, and the words after the banned text.
| def pieces($t): ($t | split(" ")) as $tw
    | [$cs[] | select(has(.s; $t)) | .w as $w
       | {w: $w, after: (first(range(0; $w | length)
                               | select(($w[.] == $tw[0] or ($w[.] | endswith("/" + $tw[0]))) and $w[. + 1:. + ($tw | length)] == $tw[1:])
                               | $w[. + ($tw | length):]) // [])}]
    | if length == 0 then [{w: [], after: []}] else . end;
# Is the ban lifted for one command? Plain "unless" words must all be among its words. With
# arg "first", the first word after the banned text that is not an option must be one of them
# (who a message goes to, not who it mentions). With arg "--flag", the flag must be there and
# each value given to it must be one of them.
def lifted($ban):
  ($ban.unless // []) as $u
  | if $ban.arg == "first" then ([.after[] | select(startswith("-") | not)] | first // "") as $a | ($u | index($a)) != null
    elif ($ban.arg // "" | startswith("--")) then
      ([.after as $a | range(0; $a | length) | $a[.] as $x
        | if $x == $ban.arg then ($a[. + 1] // "") elif ($x | startswith($ban.arg + "=")) then $x[($ban.arg | length) + 1:] else empty end]) as $v
      | ($v | length) > 0 and ($v | all(. as $x | $u | index($x) != null))
    else . as $p | $u | all(. as $x | $p.w | index($x) != null) end;
first(
  ($b[0].bans[] | . as $ban
    | select(($ban.anywhere == true and ($raw | contains($ban.text))) or has($raw; $ban.text) or has($plain; $ban.text))
    | select(($ban.unless // []) | length == 0 or any(pieces($ban.text)[]; lifted($ban) | not))
    | "`\(.text)`\(if (.unless // []) | length > 0 then " without " + (.unless | join(" ")) else "" end) is banned (\(.source))"),
  (select($b[0].background != false)
    | select($bg == "true" or ($src | nodoc | nodoc | nodoc | bg))
    | "background processes are banned (built-in)")
) // empty
JQ
hit="$(jq -rn --arg cmd "$cmd" --arg bg "$bg" --slurpfile b "$bans" "$MATCH" 2>/dev/null)" \
  || refuse "the guard could not check this command, so it was not run. Tell the human."
[ -z "$hit" ] || refuse "$hit. Do not look for another way to run it. If the job needs it, stop and tell the owner, who tells the human."
exit 0
