#!/usr/bin/env bash
# Foreman setup helper for OpenRig.
#
#   scripts/foreman init    <project> [--auditor] [--coder]   create rig.<name>.yaml + <project>/.foreman/project.yaml
#   scripts/foreman check   <project>            refuse while any SET-ME is left; validate with OpenRig
#   scripts/foreman up      <project>            check, prepare the project, launch the crew
#   scripts/foreman down    <project>            stop the crew
#   scripts/foreman unstick <project> [--once]   press Enter on unsent OpenRig messages; nudge a stalled builder (up starts it)
#   scripts/foreman tracing <project> [--off]    send every seat's traces to Langfuse (keys from env)
#   scripts/foreman bans    <project> [--off]    make every seat's runtime refuse the banned commands (up does this)
#   scripts/foreman front   <project> [--plugin <id>]   set up the human's front seat: a folder whose agent can reach the lead only
#   scripts/foreman task    <project> <job-id> <n>          write the skeleton of builder task <n> for the owner to fill in
#   scripts/foreman task-check   <project> <job-id> <n>     refuse a task file that is not ready to hand over
#   scripts/foreman result-check <project> <job-id> <n>     check the builder's result against the task and the checkout
#   scripts/foreman retro   <project> <job-id>   after a job: count how it went, write the retro task
#   scripts/foreman lesson  <project> <job-id> <seat> <evidence-file> "<lesson>"   log one lesson (three per job at most)
#   scripts/foreman habits  <project>            show the lessons ledger
#
# <project> is the path to the git repository the crew will work in.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEMPLATE="$ROOT/rig.template.yaml"
PROJECT_TEMPLATE="$ROOT/project.template.yaml"
STATE_TEMPLATE="$ROOT/state.template.md"
# Paths OpenRig and the runtimes create in the project; kept out of git via .git/info/exclude.
EXCLUDES=(.foreman/ .openrig/ .claude/ .codex/ .agents/ .pi/ .mcp.json CLAUDE.local.md)
# Of those (plus AGENTS.md), the ones OpenRig may write into. If the project tracks files there,
# they are marked skip-worktree so OpenRig's additions never show up in git status or commits.
OPENRIG_WRITES=(.claude/ .codex/ .agents/ .pi/ .mcp.json CLAUDE.local.md AGENTS.md)
SEATS=(owner checker)
OPTIONAL_SEATS=(auditor coder)   # kept by `init --<seat>`
PROJECT_KEYS=(base_branch preflight_cmd verify_cmd acceptance_tests protected_paths banned_cmds audit_every)

die() { printf 'foreman: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

usage() { sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

# --- resolve the project and its rig file -------------------------------------------------

resolve() {
  [ -n "${1:-}" ] || usage
  [ -d "$1" ] || die "project folder not found: $1"
  PROJECT="$(cd "$1" && pwd -P)"
  git -C "$PROJECT" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "$PROJECT is not a git repository"
  [ "$(git -C "$PROJECT" rev-parse --show-toplevel)" = "$PROJECT" ] \
    || die "$PROJECT is inside a git repository; point at its top folder: $(git -C "$PROJECT" rev-parse --show-toplevel)"
  SLUG="$(basename "$PROJECT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-' | sed 's/^-*//;s/-*$//')"
  [ -n "$SLUG" ] || die "cannot derive a name from $PROJECT"
  RIG_NAME="foreman-$SLUG"
  RIG_FILE="$ROOT/rig.$SLUG.yaml"
  PROJECT_FILE="$PROJECT/.foreman/project.yaml"
}

require_rig_file() {
  [ -f "$RIG_FILE" ] || die "no rig file for this project yet; run: scripts/foreman init $PROJECT"
  local recorded
  recorded="$(sed -n 's/^# project: //p' "$RIG_FILE" | head -1)"
  [ "$recorded" = "$PROJECT" ] || die "$RIG_FILE was made for '$recorded', not $PROJECT.
If you moved or renamed the project, edit the '# project:' line at the top of that file.
If two projects share the folder name '$SLUG', use a second clone of Foreman for one of them."
}

require_rig() {
  command -v rig >/dev/null 2>&1 || die "the 'rig' command (OpenRig) is not on PATH; install it first: https://www.openrig.dev"
}

# "id runtime model" for every member (a "- id:" block with an agent_ref), in file order.
# An empty runtime or model prints as "-". The rig file keeps the template's layout.
members() {
  awk '
    function clean(v) { gsub(/["\047]/, "", v); return v == "" ? "-" : v }
    function flush()  { if (ref) print id, clean(rt), clean(md) }
    /^[[:space:]]*- id:/      { flush(); id=$3; rt=""; md=""; ref=0; next }
    /^[[:space:]]*agent_ref:/ { ref=1 }
    /^[[:space:]]*runtime:/   { rt=$2 }
    /^[[:space:]]*model:/     { md=$2 }
    END                       { flush() }
  ' "$RIG_FILE"
}

# --- init ---------------------------------------------------------------------------------

cmd_init() {
  local arg project="" seat keep=" "
  for arg in "$@"; do
    case "$arg" in
      --auditor|--coder) keep="$keep${arg#--} " ;;
      -*) die "unknown option: $arg" ;;
      *) [ -z "$project" ] || die "init takes one project path"; project="$arg" ;;
    esac
  done
  resolve "$project"
  if [ -f "$RIG_FILE" ]; then
    require_rig_file
    say "kept existing $RIG_FILE"
    for seat in $keep; do
      say "note: --$seat ignored because the file already exists; delete the file and run init --$seat again (it has no secrets, only your model choices)"
    done
  else
    {
      printf '# project: %s\n' "$PROJECT"
      sed "s/^name: SET-ME$/name: $RIG_NAME/" "$TEMPLATE"
    } > "$RIG_FILE.tmp"
    for seat in "${OPTIONAL_SEATS[@]}"; do
      case "$keep" in *" $seat "*) continue ;; esac
      sed -i.bak "/--- $seat (optional)/,/--- end $seat ---/d; /$seat edge:/d" "$RIG_FILE.tmp"
      rm -f "$RIG_FILE.tmp.bak"
    done
    mv "$RIG_FILE.tmp" "$RIG_FILE"
    say "wrote $RIG_FILE (rig name $RIG_NAME$(for seat in $keep; do printf ', with the %s' "$seat"; done))"
  fi
  mkdir -p "$PROJECT/.foreman"
  if [ -f "$PROJECT_FILE" ]; then
    say "kept existing $PROJECT_FILE"
  else
    cp "$PROJECT_TEMPLATE" "$PROJECT_FILE"
    say "wrote $PROJECT_FILE"
  fi
  # The owner's memory across jobs: never overwritten, it holds the human's answers.
  if [ -f "$PROJECT/.foreman/STATE.md" ]; then
    say "kept existing $PROJECT/.foreman/STATE.md"
  else
    cp "$STATE_TEMPLATE" "$PROJECT/.foreman/STATE.md"
    say "wrote $PROJECT/.foreman/STATE.md (the owner fills it in)"
  fi
  hygiene
  say ""
  say "Next: replace every SET-ME in these two files, then run: scripts/foreman check $PROJECT"
  say "  $RIG_FILE"
  say "  $PROJECT_FILE"
}

# --- check --------------------------------------------------------------------------------

# Value of a top-level "key: value" line in project.yaml, comment stripped and trimmed. A key
# followed by a block list ("  - item" lines) prints "[list]". Prints nothing if empty or missing.
project_value() {
  awk -v k="$1" '
    found && /^[[:space:]]*(#.*)?$/ { next }
    found { if ($0 ~ /^[[:space:]]+-[[:space:]]/) print "[list]"; exit }
    index($0, k ":") == 1 {
      v = substr($0, length(k) + 2)
      sub(/[[:space:]]+#.*$/, "", v); sub(/^[[:space:]]*#.*$/, "", v)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
      if (v != "") { print v; exit }
      found = 1
    }
  ' "$PROJECT_FILE"
}

cmd_check() {
  resolve "${1:-}"
  require_rig_file
  [ -f "$PROJECT_FILE" ] || die "missing $PROJECT_FILE; run: scripts/foreman init $PROJECT"
  local problems=() id rt md key val seat found

  while read -r id rt md; do
    if [ "$rt" = SET-ME ] || [ "$md" = SET-ME ] || [ "$rt" = - ] || [ "$md" = - ]; then
      problems+=("rig file, seat $id: runtime=$rt model=$md")
    fi
  done < <(members)
  for seat in "${SEATS[@]}"; do
    found="$(members | awk -v s="$seat" '$1 == s' )"
    [ -n "$found" ] || problems+=("rig file: seat '$seat' is missing (only the auditor and the coder are optional)")
  done
  grep -q '^name: SET-ME' "$RIG_FILE" && problems+=("rig file: name is still SET-ME")
  # The owner writes STATE.md while the checker reviews, so it must never be part of a commit.
  [ -z "$(git -C "$PROJECT" ls-files -- .foreman/STATE.md)" ] \
    || problems+=(".foreman/STATE.md is tracked by git; the crew's ledger must stay out of commits. Untrack it (the file stays): git -C \"$PROJECT\" rm --cached .foreman/STATE.md, then commit")
  for key in "${PROJECT_KEYS[@]}"; do
    val="$(project_value "$key")"
    if ! grep -q "^$key:" "$PROJECT_FILE"; then problems+=("project.yaml: '$key' is missing")
    elif [ -z "$val" ]; then problems+=("project.yaml: '$key' has no value")
    elif [ "$val" = SET-ME ]; then problems+=("project.yaml: '$key' is still SET-ME")
    # YAML allows the same scalar quoted: manual, "manual" and 'manual' are one value.
    elif [ "$key" = audit_every ] && ! printf '%s' "$val" | sed -E "s/^\"(.*)\"$/\1/; s/^'(.*)'$/\1/" | grep -Eq '^([1-9][0-9]*|manual)$'; then
      problems+=("project.yaml: 'audit_every' must be a whole number of jobs or manual, not '$val'")
    fi
  done
  if [ "${#problems[@]}" -gt 0 ]; then
    say "Not ready. Fix these in $RIG_FILE"
    say "and $PROJECT_FILE:"
    printf '  - %s\n' "${problems[@]}"
    die "fill in every SET-ME above, then run check again"
  fi

  while read -r id rt md; do
    case "$rt" in
      claude-code|codex|pi) ;;
      *) die "seat $id: runtime '$rt' is not one of claude-code, codex, pi" ;;
    esac
    command -v "$( [ "$rt" = claude-code ] && echo claude || echo "$rt")" >/dev/null 2>&1 \
      || die "seat $id uses runtime '$rt', but its command is not installed on PATH"
  done < <(members)

  require_rig
  say "OpenRig validation (spec, seats and runtimes; the project folder is applied at launch):"
  rig spec validate "$RIG_FILE" || die "rig spec validate failed (see above)"
  rig spec preflight "$RIG_FILE" || die "rig spec preflight failed (see above; is the daemon running? 'rig daemon start')"
  say "(permission_policy warnings are expected: seats launch at OpenRig's default permission floor)"
  check_pi_keys
  say "check passed: $RIG_NAME is ready to launch with: scripts/foreman up $PROJECT"
}

# Pi seats on OpenRouter need OPENROUTER_API_KEY on the daemon's allowlist (and in the daemon's
# environment, which this script cannot see). Other providers are either built into Pi or come
# from the user's Pi models.json.
check_pi_keys() {
  local id rt md need_or=0
  while read -r id rt md; do
    [ "$rt" = pi ] || continue
    case "$md" in
      openrouter/*) need_or=1 ;;
      *) [ -f "$(pi_home)/models.json" ] \
           || say "warning: seat $id uses provider '${md%%/*}' and there is no $(pi_home)/models.json; fine only if Pi has it built in (check: pi --list-models '${md#*/}')" ;;
    esac
  done < <(members)
  if [ "$need_or" -eq 1 ]; then
    require_rig
    local allow
    allow="$(rig config get recovery.provider_auth_env_allowlist 2>/dev/null | tr -d '[]" ' || true)"
    case ",$allow," in
      *,OPENROUTER_API_KEY,*) ;;
      *) die "pi seats on OpenRouter need the key passed through to them. Run once:
  rig config set recovery.provider_auth_env_allowlist ${allow:+$allow,}OPENROUTER_API_KEY
then restart the daemon from a shell where OPENROUTER_API_KEY is exported:
  rig daemon stop && rig daemon start
(restarting the daemon affects every rig on it; check 'rig ps' first)" ;;
    esac
    case "$(daemon_has_env OPENROUTER_API_KEY)" in
      no) die "OPENROUTER_API_KEY is allowlisted but the running daemon does not have it in its environment.
Restart the daemon from a shell where the key is exported:
  rig daemon stop && rig daemon start
(restarting the daemon affects every rig on it; check 'rig ps' first)" ;;
      yes) ;;
      *) say "note: could not inspect the daemon's environment; OPENROUTER_API_KEY must be exported in the shell that started it" ;;
    esac
  fi
}

# "yes"/"no" if the running daemon's environment has variable $1, "unknown" if it can't be read
# (only Linux exposes another process's environment, via /proc).
daemon_has_env() {
  local pid
  pid="$(rig daemon status 2>/dev/null | sed -n 's/.*(pid \([0-9][0-9]*\)).*/\1/p')"
  if [ -n "$pid" ] && [ -r "/proc/$pid/environ" ]; then
    if tr '\0' '\n' < "/proc/$pid/environ" | grep -q "^$1=."; then echo yes; else echo no; fi
  else
    echo unknown
  fi
}

pi_home() { printf '%s' "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"; }

# --- up / down ----------------------------------------------------------------------------

cmd_up() {
  cmd_check "${1:-}"
  hygiene
  seed_pi_models
  install_bans 0
  say "Launching $RIG_NAME in $PROJECT ..."
  # OpenRig exits non-zero when any seat needs a person before it can start (a Codex seat
  # asking to trust a new hook, for one). The other seats are up by then, so the watcher is
  # started either way, and the steps for the waiting seat are spelled out.
  local out rc=0 seat
  out="$(rig up "$RIG_FILE" --cwd "$PROJECT" 2>&1)" || rc=$?
  [ -z "$out" ] || printf '%s\n' "$out"
  say ""
  if [ "$rc" -eq 0 ]; then say "The crew is starting. Watch it with: rig tui   (or: rig ps)"
  else say "The crew started, but OpenRig reported a problem (see above). Check: rig ps --nodes --rig $RIG_NAME"; fi
  say "Talk to the owner with: tmux attach -t crew-owner@$RIG_NAME   (Ctrl-b d to leave)"
  say "If a seat asks whether to start fresh, answer y (Enter alone means No)."
  start_unstick
  while IFS= read -r seat; do
    [ -n "$seat" ] || continue
    say ""
    say "Seat $seat is waiting for you to trust a hook. It is Foreman's command guard, which makes"
    say "the seat refuse banned commands. Until you answer, that seat does nothing:"
    say "  1. tmux attach -t '$seat'"
    say "  2. choose \"Trust all and continue\" (or review it first), then leave with Ctrl-b d"
    say "  3. rig seat continue '$seat'"
  done < <(printf '%s\n' "$out" | sed -n 's/.*(\([A-Za-z0-9._-]*@[A-Za-z0-9._-]*\)).*hook trust.*/\1/p' | sort -u)
  return "$rc"
}

cmd_down() {
  resolve "${1:-}"
  require_rig
  rig down "$RIG_NAME"
  stop_unstick
}

# --- unstick ------------------------------------------------------------------------------
#
# OpenRig delivers a message by pasting it into the seat's prompt, waiting 200 ms and pressing
# Enter once. It never checks that the message was sent. Sometimes the Enter is lost and the
# message sits unsent in the prompt until a human presses Enter (see docs/troubleshooting.md).
# This watcher presses Enter for the seat, only when all of these hold:
#   - the seat's unsent prompt is OpenRig's: it starts with OpenRig's header ("From:" or the
#     watchdog's "[OpenRig watchdog scheduler") and shows its reply line or the watchdog header.
#     Text typed before it, or any folded paste ("[Pasted text #N ...]", which hides who pasted
#     it), means a human may be in it: never pressed. (OpenRig's messages render inline.)
#   - the pane has not changed for UNSTICK_IDLE seconds (the seat is not working, nobody typing);
#   - it has pressed fewer than UNSTICK_TRIES times for this exact pane.
# Every press is logged.
UNSTICK_IDLE="${FOREMAN_UNSTICK_IDLE:-60}"
UNSTICK_EVERY="${FOREMAN_UNSTICK_EVERY:-20}"
UNSTICK_TRIES=3
UNSTICK_MARKERS=('RET>Reply:rigsend' '[OpenRigwatchdogscheduler')   # as flatten() leaves them

unstick_session() { printf 'foreman-unstick@%s' "$RIG_NAME"; }
unstick_dir() { printf '%s/foreman-unstick/%s' "${OPENRIG_HOME:-$HOME/.openrig}" "$RIG_NAME"; }

start_unstick() {
  command -v tmux >/dev/null 2>&1 || { say "note: tmux not found, so the unstick watcher is not running"; return 0; }
  local s; s="$(unstick_session)"
  tmux has-session -t "=$s" 2>/dev/null && return 0
  tmux new-session -d -s "$s" "$(printf '%q ' "$ROOT/scripts/foreman" unstick "$PROJECT")"
  say "Unstick watcher running (tmux session $s; log: $(unstick_dir)/log)."
}

stop_unstick() {
  command -v tmux >/dev/null 2>&1 || return 0
  tmux kill-session -t "=$(unstick_session)" 2>/dev/null || true
}

# The unsent prompt of a seat on runtime $1, from its first line to the bottom of the pane.
# claude-code: the input line starts with "❯" and a no-break space (sent messages above it use a
# plain space, so they never match). codex: the last line starting with "›" (tmux trims the space
# of an empty prompt). No prompt line found, or any other runtime: nothing. pi draws no prompt
# marker, so its unsent text cannot be told from what it already sent: pi seats are not watched.
staged_region() {
  awk -v rt="$1" -v claude="^❯"$'\xc2\xa0' '{ l[NR]=$0 }
    rt == "claude-code" && $0 ~ claude { p=NR }
    rt == "codex" && /^›( |$)/ { p=NR }
    END {
      if (!p) exit
      for (i=p; i<=NR; i++) print l[i]
    }'
}

# One line of printable ASCII: side panel dropped (text after a │), the reply arrow kept as
# "RET>", then every other byte that is not printable ASCII removed. Any kind of space is gone,
# so a prompt that wraps, or spaces of any width, still show the marker whole.
flatten() { awk '{ sub(/│.*$/, ""); gsub(/↩/, "RET>"); print }' | LC_ALL=C tr -cd '[:graph:]'; }


unstick_log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$(unstick_dir)/log"; }

unstick_pass() {
  local id rt md seat pane region m hit now since tries f _h
  now="$(date +%s)"
  while read -r id rt md; do
    seat="crew-$id@$RIG_NAME"
    f="$(unstick_dir)/$seat"
    # The trailing x keeps trailing blank rows, so a change there still counts as a change.
    pane="$(tmux capture-pane -p -t "=$seat:" 2>/dev/null && printf x)" || { rm -f "$f" "$f.pane"; continue; }
    region="$(printf '%s' "${pane%x}" | staged_region "$rt" | flatten)"
    hit=0
    case "$region" in
      *'[Pastedtext#'*|*'[PastedContent'*) ;;                       # a fold: could be anyone's
      'From:'*|'[OpenRigwatchdogscheduler'*)                          # starts as OpenRig's
        for m in "${UNSTICK_MARKERS[@]}"; do case "$region" in *"$m"*) hit=1 ;; esac; done ;;
    esac
    [ "$hit" = 1 ] || { rm -f "$f" "$f.pane"; continue; }
    # State: a copy of the pane ($f.pane) and "since tries" ($f). Any byte of difference, or a
    # record that is not two short plain numbers, starts the idle timer over.
    printf '%s' "$pane" > "$f.new"
    _h="$(cat "$f" 2>/dev/null)" || _h=""
    since="${_h% *}"; tries="${_h#* }"
    if ! cmp -s "$f.new" "$f.pane" || ! [[ "$_h" =~ ^[0-9]{1,12}\ [0-9]{1,2}$ ]] \
      || [ "$(wc -l < "$f" 2>/dev/null || echo 0)" -ne 1 ]; then   # the whole value, not one line of it
      mv "$f.new" "$f.pane"; printf '%s 0\n' "$now" > "$f"; continue
    fi
    rm -f "$f.new"
    since=$((10#$since)); tries=$((10#$tries))
    [ $((now - since)) -ge "$UNSTICK_IDLE" ] || continue
    if [ "$tries" -ge "$UNSTICK_TRIES" ]; then
      [ "$tries" -eq "$UNSTICK_TRIES" ] && unstick_log "$seat: OpenRig message still unsent after $tries presses; leaving it for a human"
      printf '%s %s\n' "$since" $((UNSTICK_TRIES + 1)) > "$f"
      continue
    fi
    tmux send-keys -t "=$seat:" Enter || continue
    tries=$((tries + 1))
    printf '%s %s\n' "$since" "$tries" > "$f"
    unstick_log "$seat: pressed Enter on an unsent OpenRig message (pane unchanged $((now - since))s, press $tries)"
  done < <(members)
}

# --- stall: a builder idle on a task it claimed ---------------------------------------------
#
# A builder on a small local model can end a turn with nothing done: it spends its whole reply
# limit thinking, the runtime ends the turn, and the seat sits at its prompt with the task still
# claimed. Nothing in OpenRig wakes it, and the owner, waiting at its own prompt, has no clock.
# Any message restarts it. So, for each seat in STALL_SEATS, when all of these hold:
#   - its pane has not changed for STALL_IDLE seconds (a working seat redraws);
#   - its turn has ended. A pi seat's session record says so: the last message is the model's
#     and asks for no tool. While a tool runs or the model is answering, a quiet pane is work,
#     and the seat is left alone until the pane has been still for four times STALL_IDLE. A seat
#     with no readable record is judged on its pane alone;
#   - the queue shows a task it claimed and has not handed back (state in-progress);
# the watcher sends it one message naming the task. After STALL_NUDGES nudges on the same task
# it tells the owner once and stops. The count is kept per task, so it survives the seat's pane
# vanishing or the queue showing another task for a while. Every nudge is logged, and recorded
# in stalls.jsonl so the retro can count them. It only ever sends messages: it presses no key
# in the seat's pane.
STALL_IDLE="${FOREMAN_STALL_IDLE:-300}"
STALL_NUDGES=3
STALL_SEATS=(coder)

stall_record() { jq -cn --arg at "$(date -u +%FT%TZ)" --arg seat "$1" --arg item "$2" "$3" >> "$(unstick_dir)/stalls.jsonl"; }

# Is the seat on runtime $1 named $2 in the middle of a turn? Only a pi seat can say.
mid_turn() {
  [ "$1" = pi ] || return 1
  local s last
  s="$(ls -t "${OPENRIG_HOME:-$HOME/.openrig}/state/pi/$2/sessions"/*.jsonl 2>/dev/null | head -1)" || true
  [ -n "$s" ] || return 1
  last="$(tail -n 40 "$s" 2>/dev/null | jq -rR 'fromjson? | select(.type == "message") | .message.role + " " + (.message.stopReason // "")' 2>/dev/null | tail -n 1)" || true
  case "$last" in "assistant toolUse"|"toolResult "*|"user "*) return 0 ;; *) return 1 ;; esac
}

stall_pass() {
  local id rt md seat pane f c _h since nudges told item now idle owner="crew-owner@$RIG_NAME"
  now="$(date +%s)"
  while read -r id rt md; do
    case " ${STALL_SEATS[*]} " in *" $id "*) ;; *) continue ;; esac
    seat="crew-$id@$RIG_NAME"
    f="$(unstick_dir)/$seat.stall"
    pane="$(tmux capture-pane -p -t "=$seat:" 2>/dev/null && printf x)" || { rm -f "$f" "$f.pane"; continue; }
    # State: a copy of the pane ($f.pane) and the time it was first seen like that ($f). A
    # changed pane, or a record that is not one plain number, starts the idle timer over.
    printf '%s' "$pane" > "$f.new"
    _h="$(cat "$f" 2>/dev/null)" || _h=""
    if ! cmp -s "$f.new" "$f.pane" || ! [[ "$_h" =~ ^[0-9]{1,12}$ ]] \
      || [ "$(wc -l < "$f" 2>/dev/null || echo 0)" -ne 1 ]; then   # the whole value, not one line of it
      mv "$f.new" "$f.pane"; printf '%s\n' "$now" > "$f"; continue
    fi
    rm -f "$f.new"
    since=$((10#$_h)); idle=$((now - since))
    [ "$idle" -ge "$STALL_IDLE" ] || continue
    if mid_turn "$rt" "$seat" && [ "$idle" -lt $((STALL_IDLE * 4)) ]; then continue; fi
    # Idle long enough. Whatever is found, the next look is a full stall time away.
    printf '%s\n' "$now" > "$f"
    item="$(rig queue list --destination "$seat" --state in-progress --json 2>/dev/null \
          | jq -r '[.[] | select(.state == "in-progress") | .qitemId // empty] | last // empty' 2>/dev/null)" || item=""
    [[ "$item" =~ ^[A-Za-z0-9_][A-Za-z0-9._:-]{0,119}$ ]] || continue
    # The count for this task: "nudges told".
    c="$(unstick_dir)/stall-items/$seat/$item"; mkdir -p "${c%/*}"
    _h="$(cat "$c" 2>/dev/null)" || _h=""
    [[ "$_h" =~ ^[0-9]\ [01]$ ]] || _h="0 0"
    read -r nudges told <<<"$_h"
    # The count is written before anything is sent. If it cannot be written, nothing is sent:
    # a count that does not stick would let the nudges go on without limit.
    if [ "$nudges" -lt "$STALL_NUDGES" ]; then
      { printf '%s %s\n' "$((nudges + 1))" "$told" > "$c"; } 2>/dev/null \
        || { unstick_log "$seat: idle on $item, but its nudge count cannot be saved ($c); not nudging"; continue; }
      rig send "$seat" "From the Foreman watcher: you stopped with your claimed task unfinished (queue item $item). Carry on with it now. Open the task file it names if you need to, finish the code, run the command, write the result file, and hand back to crew-owner. If you cannot finish, write the result with status: stuck and the reason, and hand back anyway." >/dev/null 2>&1 \
        || { printf '%s %s\n' "$nudges" "$told" > "$c"; unstick_log "$seat: idle on $item, but the nudge could not be sent"; continue; }
      nudges=$((nudges + 1))
      stall_record "$seat" "$item" "{at:\$at, seat:\$seat, item:\$item, nudge:$nudges}"
      unstick_log "$seat: nudged, idle on claimed task $item (pane unchanged ${idle}s, nudge $nudges of $STALL_NUDGES)"
    elif [ "$told" = 0 ]; then
      { printf '%s 1\n' "$nudges" > "$c"; } 2>/dev/null \
        || { unstick_log "$seat: still idle on $item, but its record cannot be saved ($c); not telling the owner again and again"; continue; }
      rig send "$owner" "From the Foreman watcher: the builder ($seat) is still idle on its claimed task (queue item $item) after $STALL_NUDGES nudges. Do not wait for it. Look at what it left in the checkout, then build the piece yourself or hand it over again as a smaller task. Note the time lost in LOG.md and the reason in DECISIONS.md." >/dev/null 2>&1 \
        || { printf '%s 0\n' "$nudges" > "$c"; unstick_log "$seat: still idle on $item after $STALL_NUDGES nudges, but the owner could not be told; will try again"; continue; }
      told=1
      stall_record "$seat" "$item" '{at:$at, seat:$seat, item:$item, told_owner:true}'
      unstick_log "$seat: still idle on $item after $STALL_NUDGES nudges; told the owner"
    fi
  done < <(members)
}

cmd_unstick() {
  local once=0
  [ "${2:-}" = --once ] && once=1
  resolve "${1:-}"
  require_rig_file
  command -v tmux >/dev/null 2>&1 || die "tmux not found"
  mkdir -p "$(unstick_dir)"
  # One watcher per crew at a time: two would each count their own presses and nudges.
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$(unstick_dir)/lock"
    flock -n 9 || { say "another watcher is already running for $RIG_NAME; this one did nothing"; return 0; }
  else
    say "note: flock not found, so nothing stops a second watcher for $RIG_NAME. Run only one."
  fi
  if [ "$once" = 1 ]; then unstick_pass; stall_pass; return 0; fi
  say "Watching $RIG_NAME for unsent OpenRig messages and a stalled builder (every ${UNSTICK_EVERY}s). Ctrl-C to stop."
  while :; do unstick_pass || true; stall_pass || true; sleep "$UNSTICK_EVERY"; done
}

# OpenRig gives each pi seat its own agent dir and does not copy models.json into it.
# Link the user's file in before launch so custom providers (Ollama, vLLM, ...) resolve.
seed_pi_models() {
  local src id rt md dir
  src="$(pi_home)/models.json"
  [ -f "$src" ] || return 0
  while read -r id rt md; do
    [ "$rt" = pi ] || continue
    dir="${OPENRIG_HOME:-$HOME/.openrig}/state/pi/crew-$id@$RIG_NAME/agent"
    mkdir -p "$dir"
    if [ -e "$dir/models.json" ] && [ ! -L "$dir/models.json" ]; then
      say "keeping the seat's own $dir/models.json"
    else
      ln -sfn "$src" "$dir/models.json"
    fi
  done < <(members)
}

# --- tracing (Langfuse) -------------------------------------------------------------------

# Each runtime has its own Langfuse plugin and reads keys from its own place. Keys are scoped to
# this project and this crew, never written globally, so other work on the machine is not traced:
#   claude-code: env block in <project>/.claude/settings.local.json
#   codex:       <project>/.codex/langfuse.json
#   pi:          langfuse.json in each seat's own agent dir (OpenRig strips env vars from Pi)
CLAUDE_PLUGIN="langfuse-observability@langfuse-observability"
CODEX_PLUGIN="tracing@codex-observability-plugin"
PI_PLUGIN="npm:@langfuse/pi-observability-plugin"

cmd_tracing() {
  local off=0 arg project=""
  for arg in "$@"; do
    case "$arg" in
      --off) off=1 ;;
      -*) die "unknown option: $arg" ;;
      *) [ -z "$project" ] || die "tracing takes one project path"; project="$arg" ;;
    esac
  done
  resolve "$project"
  require_rig_file
  command -v node >/dev/null 2>&1 || die "node is needed to edit the JSON settings files (OpenRig needs it too)"
  hygiene >/dev/null
  if [ "$off" -eq 0 ]; then
    [ -n "${LANGFUSE_PUBLIC_KEY:-}" ] && [ -n "${LANGFUSE_SECRET_KEY:-}" ] && [ -n "${LANGFUSE_BASE_URL:-}" ] \
      || die "export LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY and LANGFUSE_BASE_URL first (see docs/observability.md).
Typing them keeps them out of your shell history:
  read -rs LANGFUSE_SECRET_KEY && export LANGFUSE_SECRET_KEY"
  fi

  local runtimes id rt md
  runtimes="$(members | awk '{print $2}' | sort -u)"
  case "$runtimes" in *claude-code*) trace_claude "$off" ;; esac
  case "$runtimes" in *codex*) trace_codex "$off" ;; esac
  while read -r id rt md; do
    [ "$rt" = pi ] && trace_pi "$off" "$id"
  done < <(members)

  if [ "$off" -eq 1 ]; then
    say "tracing is off for $RIG_NAME. Restart the crew for running seats to stop sending traces."
  else
    say "tracing is on for $RIG_NAME (environment/tag '$RIG_NAME')."
    say "Restart the crew so every seat picks it up: scripts/foreman down $PROJECT && scripts/foreman up $PROJECT"
    say "Then check traces arrive: docs/observability.md, 'Is it working?'"
  fi
}

# Refuse to put a secret in a file git could ever commit.
secret_file_ok() {
  local rel="${1#"$PROJECT"/}"
  [ -z "$(git -C "$PROJECT" ls-files -- "$rel")" ] || die "$rel is tracked by git; refusing to write Langfuse keys into it"
  git -C "$PROJECT" check-ignore -q -- "$rel" || die "$rel is not ignored by git; refusing to write Langfuse keys into it"
}

# Write JSON with node. The file path and values travel in env vars, never on a command line
# (other users can read command lines). $1 = merge script body; FILE must be set.
json_edit() {
  ( umask 077; node -e '
      const fs = require("fs"), f = process.env.FILE;
      let j = {}; try { j = JSON.parse(fs.readFileSync(f, "utf8")); } catch (e) { if (e.code !== "ENOENT") throw e; }
      const out = (new Function("j", "env", process.argv[1]))(j, process.env);
      if (out === null) { try { fs.unlinkSync(f); } catch {} }
      else { fs.writeFileSync(f, JSON.stringify(out, null, 2) + "\n"); fs.chmodSync(f, 0o600); }
    ' "$1" ) || die "could not update $FILE"
}

trace_claude() {
  local file="$PROJECT/.claude/settings.local.json"
  if [ "$1" -eq 0 ]; then
    claude plugin list 2>/dev/null | grep -q "${CLAUDE_PLUGIN%@*}" || die "claude-code seats need the Langfuse plugin. Install it once (no keys; Foreman sets them per project):
  claude plugin marketplace add langfuse/Claude-Observability-Plugin
  claude plugin install $CLAUDE_PLUGIN"
    command -v uv >/dev/null 2>&1 || say "warning: uv is not on PATH; the Claude plugin falls back to python3 with the langfuse package (see docs/observability.md)"
  fi
  mkdir -p "$PROJECT/.claude"; secret_file_ok "$file"
  FILE="$file" TAG="$RIG_NAME" OFF="$1" json_edit '
    const keys = ["LANGFUSE_PUBLIC_KEY", "LANGFUSE_SECRET_KEY", "LANGFUSE_BASE_URL", "CC_LANGFUSE_TRACE_TAGS"];
    j.env = j.env || {};
    for (const k of keys) delete j.env[k];
    if (env.OFF !== "1") Object.assign(j.env, {LANGFUSE_PUBLIC_KEY: env.LANGFUSE_PUBLIC_KEY,
      LANGFUSE_SECRET_KEY: env.LANGFUSE_SECRET_KEY, LANGFUSE_BASE_URL: env.LANGFUSE_BASE_URL, CC_LANGFUSE_TRACE_TAGS: env.TAG});
    if (!Object.keys(j.env).length) delete j.env;
    return j;'
  say "claude-code seats: $( [ "$1" -eq 1 ] && echo 'keys removed from' || echo 'keys set in') .claude/settings.local.json"
}

trace_codex() {
  local file="$PROJECT/.codex/langfuse.json"
  if [ "$1" -eq 0 ]; then
    grep -qF "\"$CODEX_PLUGIN\"" "${CODEX_HOME:-$HOME/.codex}/config.toml" 2>/dev/null || die "codex seats need the Langfuse plugin. Install it once:
  codex plugin marketplace add langfuse/codex-observability-plugin
then add to ~/.codex/config.toml:
  [features]
  hooks = true
  [plugins.\"$CODEX_PLUGIN\"]
  enabled = true"
  fi
  mkdir -p "$PROJECT/.codex"; secret_file_ok "$file"
  FILE="$file" TAG="$RIG_NAME" OFF="$1" json_edit '
    if (env.OFF === "1") return null;
    return {enabled: true, public_key: env.LANGFUSE_PUBLIC_KEY, secret_key: env.LANGFUSE_SECRET_KEY,
      base_url: env.LANGFUSE_BASE_URL, environment: env.TAG, tags: [env.TAG]};'
  say "codex seats: $( [ "$1" -eq 1 ] && echo 'removed' || echo 'wrote') .codex/langfuse.json"
  [ "$1" -eq 1 ] || say "  codex: the first time, open each codex seat and trust the Langfuse Stop hook in /hooks; no traces until you do"
}

trace_pi() {
  local session="crew-$2@$RIG_NAME" dir
  dir="${OPENRIG_HOME:-$HOME/.openrig}/state/pi/$session/agent"
  mkdir -p "$dir"
  if [ "$1" -eq 0 ]; then
    grep -qF "${PI_PLUGIN#npm:}" "$dir/settings.json" 2>/dev/null \
      || PI_CODING_AGENT_DIR="$dir" pi install "$PI_PLUGIN" >/dev/null \
      || die "pi install $PI_PLUGIN failed for seat $2"
  fi
  FILE="$dir/langfuse.json" SESSION="$session" TAG="$RIG_NAME" OFF="$1" json_edit '
    if (env.OFF === "1") return null;
    return {publicKey: env.LANGFUSE_PUBLIC_KEY, secretKey: env.LANGFUSE_SECRET_KEY,
      baseUrl: env.LANGFUSE_BASE_URL, userId: env.SESSION, environment: env.TAG};'
  say "pi seat $2: $( [ "$1" -eq 1 ] && echo 'tracing removed' || echo 'plugin installed, langfuse.json written')"
}

# --- git hygiene --------------------------------------------------------------------------

# Keep OpenRig's and the runtimes' files out of the project's git status, without touching
# the project's .gitignore: untracked ones via .git/info/exclude, tracked ones OpenRig may
# write into (AGENTS.md, .mcp.json, .claude/...) via skip-worktree.
hygiene() {
  local exclude entry f tracked
  exclude="$(git -C "$PROJECT" rev-parse --git-path info/exclude)"
  case "$exclude" in /*) ;; *) exclude="$PROJECT/$exclude" ;; esac
  mkdir -p "$(dirname "$exclude")"
  touch "$exclude"
  add_exclude() { grep -qxF "$1" "$exclude" || printf '%s\n' "$1" >> "$exclude"; }
  for entry in "${EXCLUDES[@]}"; do add_exclude "$entry"; done
  if [ -n "$(git -C "$PROJECT" ls-files -- .foreman/ | head -1)" ]; then
    say "note: this project already tracks files in .foreman/. Those stay tracked as ordinary repo"
    say "      files (the owner changes them only on a job branch). Everything the crew writes there"
    say "      itself, including STATE.md, is kept out of git (see docs/how-it-works.md)."
  fi
  for entry in "${OPENRIG_WRITES[@]}"; do
    tracked="$(git -C "$PROJECT" ls-files -- "$entry")"
    if [ -z "$tracked" ]; then add_exclude "$entry"; continue; fi
    while IFS= read -r f; do
      git -C "$PROJECT" update-index --skip-worktree -- "$f"
      say "marked tracked $f skip-worktree (OpenRig may write to it; see docs/troubleshooting.md)"
    done <<< "$tracked"
  done
}

# --- banned commands, refused by each seat's runtime ----------------------------------------
# The project's banned_cmds and Foreman's built-in bans are written to <project>/.foreman/bans.json,
# and each runtime is told to ask scripts/foreman-guard before it runs a shell command:
#   claude-code  a PreToolUse hook in <project>/.claude/settings.local.json
#   codex        a PreToolUse hook in <project>/.codex/hooks.json (the human trusts it once per seat, in /hooks)
#   pi           an extension in each pi seat's own agent folder
# A banned command is then refused before it runs, whatever the seat's prompt says.

BUILTIN_BANS=("git push" "git remote add" "git remote set-url" "git remote remove" "git remote rm" "git remote rename" "gh")

# Write the ban list. A banned_cmds entry is plain text, or "text (without word word)": banned
# unless the command also has every one of those words.
write_bans() {
  local raw; raw="$(project_value banned_cmds)"
  [ "$raw" != "[list]" ] || die "banned_cmds in $PROJECT_FILE is a dash list; write it on one line: banned_cmds: [\"vercel\", \"supabase db push\"]"
  [ -n "$raw" ] || raw="[]"
  jq -e 'type == "array" and all(.[]; type == "string")' <<<"$raw" >/dev/null 2>&1 \
    || die "banned_cmds in $PROJECT_FILE must be a list of texts in quotes on one line, e.g. [\"vercel\", \"supabase db push\"]"
  mkdir -p "$PROJECT/.foreman"
  jq -n --argjson p "$raw" --args '
    {project: $ENV.PROJECT_DIR, background: true,
     bans: ([$ARGS.positional[] | {text: ., source: "built-in"}]
          + [$p[] | select(length > 0) | (capture("^(?<text>.*\\S)\\s*\\(without (?<u>[^)]*)\\)\\s*$") // null) as $m
             | if $m then {text: $m.text, unless: ($m.u | split(" ") | map(select(length > 0))), source: "banned_cmds"}
               else {text: ., source: "banned_cmds"} end])}' "${BUILTIN_BANS[@]}" >"$PROJECT/.foreman/bans.json.tmp" \
    && mv "$PROJECT/.foreman/bans.json.tmp" "$PROJECT/.foreman/bans.json"
}

# install_bans <off>: 0 writes the list and the three hooks, 1 removes them.
install_bans() {
  local off="$1" guard="$ROOT/scripts/foreman-guard" list="$PROJECT/.foreman/bans.json" hook runtimes id rt md dir
  command -v node >/dev/null 2>&1 || die "node is needed to edit the JSON settings files (OpenRig needs it too)"
  command -v jq >/dev/null 2>&1 || die "jq is needed for the command guard"
  if [ "$off" -eq 0 ]; then PROJECT_DIR="$PROJECT" write_bans; else rm -f "$list"; fi
  hook="$(printf '%q %q' "$guard" "$list")"
  runtimes="$(members | awk '{print $2}' | sort -u)"
  # Turning the guard off cleans both files whatever the crew runs on now: a seat that changed
  # runtime must not be left with a hook pointing at a ban list that is gone.
  if [ "$off" -eq 1 ] || [[ "$runtimes" == *claude-code* ]]; then
    if [ "$off" -eq 0 ] || [ -f "$PROJECT/.claude/settings.local.json" ]; then
      mkdir -p "$PROJECT/.claude"
      FILE="$PROJECT/.claude/settings.local.json" HOOK="$hook" OFF="$off" MATCH="Bash" json_edit "$BAN_EDIT"
    fi
  fi
  if [ "$off" -eq 1 ] || [[ "$runtimes" == *codex* ]]; then
    if [ "$off" -eq 0 ] || [ -f "$PROJECT/.codex/hooks.json" ]; then
      mkdir -p "$PROJECT/.codex"
      FILE="$PROJECT/.codex/hooks.json" HOOK="$hook" OFF="$off" MATCH="^Bash$" json_edit "$BAN_EDIT"
    fi
  fi
  # Off: every seat of this crew that ever ran on pi, not only the ones that do today.
  if [ "$off" -eq 1 ]; then rm -f "${OPENRIG_HOME:-$HOME/.openrig}/state/pi"/crew-*@"$RIG_NAME"/agent/extensions/foreman-guard.ts; fi
  while read -r id rt md; do
    [ "$rt" = pi ] || continue
    dir="${OPENRIG_HOME:-$HOME/.openrig}/state/pi/crew-$id@$RIG_NAME/agent/extensions"
    [ "$off" -eq 0 ] || continue
    mkdir -p "$dir"
    GUARD="$guard" LIST="$list" node -e '
      const fs = require("fs");
      fs.writeFileSync(process.argv[1], `// Written by scripts/foreman bans. Asks Foreman'"'"'s guard before every shell command.
import { execFileSync } from "node:child_process";
const GUARD = ${JSON.stringify(process.env.GUARD)};
const LIST = ${JSON.stringify(process.env.LIST)};
export default function (pi) {
  pi.on("tool_call", async (event) => {
    if (event.toolName !== "bash") return undefined;
    try {
      execFileSync(GUARD, [LIST, "--command"], { input: String(event.input?.command ?? ""), stdio: ["pipe", "ignore", "pipe"] });
      return undefined;
    } catch (e) {
      const why = String(e?.stderr ?? "").trim() || "Blocked by Foreman: the guard could not run, so the command was not run. Tell the owner.";
      return { block: true, reason: why };
    }
  });
}
`);' "$dir/foreman-guard.ts" || die "could not write the pi extension for seat $id"
  done < <(members)
}

# The JSON edit shared by claude-code and codex: one PreToolUse entry that runs the guard, and
# nothing else of ours. Entries that are not ours are left as they are.
BAN_EDIT='
  const ours = (h) => typeof h.command === "string" && h.command.includes("foreman-guard");
  j.hooks = j.hooks || {};
  // Drop only our own hook. A group that held other hooks beside it keeps them.
  const pre = (j.hooks.PreToolUse || [])
    .map((g) => Object.assign({}, g, {hooks: (g.hooks || []).filter((h) => !ours(h))}))
    .filter((g) => g.hooks.length);
  if (env.OFF !== "1") pre.push({matcher: env.MATCH, hooks: [{type: "command", command: env.HOOK, timeout: 10}]});
  if (pre.length) j.hooks.PreToolUse = pre; else delete j.hooks.PreToolUse;
  if (!Object.keys(j.hooks).length) delete j.hooks;
  return Object.keys(j).length ? j : null;'

cmd_bans() {
  local off=0 arg project="" id rt md
  for arg in "$@"; do
    case "$arg" in --off) off=1 ;; -*) die "unknown option: $arg" ;; *) [ -z "$project" ] || die "bans takes one project path"; project="$arg" ;; esac
  done
  resolve "$project"; require_rig_file
  hygiene >/dev/null
  install_bans "$off"
  if [ "$off" -eq 1 ]; then say "the command guard is off for $RIG_NAME. Restart the crew for running seats to drop it."; return; fi
  say "banned for $RIG_NAME (built-in bans plus banned_cmds; background processes too):"
  jq -r '.bans[] | "  " + .text + (if .unless then "   (unless the command has: " + (.unless | join(" ")) + ")" else "" end)' "$PROJECT/.foreman/bans.json"
  say ""
  while read -r id rt md; do
    case "$rt" in
      claude-code) say "seat $id (claude-code): refused by a hook in .claude/settings.local.json" ;;
      codex) say "seat $id (codex): refused by a hook in .codex/hooks.json, ONCE YOU TRUST IT: open the seat, type /hooks, and trust the Foreman guard. Until then codex ignores it." ;;
      pi) say "seat $id (pi): refused by an extension in the seat's own agent folder" ;;
      *) say "seat $id ($rt): NOT covered; Foreman has no guard for this runtime" ;;
    esac
  done < <(members)
  say ""
  say "Restart the crew so every seat loads it: scripts/foreman down $PROJECT && scripts/foreman up $PROJECT"
}

# --- the front seat -------------------------------------------------------------------------
# The front seat is the human's own agent session (Claude Code, in whatever app runs it), in a
# folder of its own: ~/front/<project name>. There the human works out a job and the agent writes
# the issue and hands the job to the lead. The folder's settings, not its prompt, keep that
# session away from every other seat:
#   - the command guard refuses `rig send` and `rig queue` unless the command names the lead,
#     and any command that names the QA rig, its home folder or its command
#   - a deny rule refuses reading the QA rig's home folder
# One folder per project, all made the same way, so a new project needs only this command.
FRONT_TEMPLATE="$ROOT/front.template.md"

cmd_front() {
  local arg project="" plugins=() want="" dir lead qa_home qa_rig list hook text k
  for arg in "$@"; do
    if [ -n "$want" ]; then plugins+=("$arg"); want=""; continue; fi
    case "$arg" in --plugin) want=1 ;; -*) die "unknown option: $arg" ;; *) [ -z "$project" ] || die "front takes one project path"; project="$arg" ;; esac
  done
  [ -z "$want" ] || die "--plugin needs a plugin id, e.g. --plugin name@marketplace"
  resolve "$project"; require_rig_file
  command -v node >/dev/null 2>&1 || die "node is needed to edit the JSON settings files (OpenRig needs it too)"
  command -v jq >/dev/null 2>&1 || die "jq is needed for the command guard"
  [ -f "$FRONT_TEMPLATE" ] || die "missing $FRONT_TEMPLATE"
  dir="${FOREMAN_FRONT_HOME:-$HOME/front}/$SLUG"
  lead="crew-owner@$RIG_NAME"
  qa_home="${QA_HOME:-$HOME/.foreman-qa}"; qa_rig="${QA_RIG:-foreman-qa}"
  list="$dir/.foreman-front/bans.json"
  mkdir -p "$dir/.claude" "$dir/.foreman-front" "$PROJECT/.foreman/inbox"
  jq -n --arg dir "$dir" --arg lead "$lead" --args '
    {project: $dir, background: false,
     bans: ([{text: "rig send", arg: "first"}, {text: "rig queue", arg: "--destination"} | . + {unless: [$lead], source: "front seat: the lead is the only seat it may message"}]
          + [$ARGS.positional[] | {text: ., anywhere: true, source: "front seat: the QA rig is out of reach"}])}' \
    "$qa_rig" "$qa_home" "$ROOT/scripts/qa" >"$list.tmp" && mv "$list.tmp" "$list"
  hook="$(printf '%q %q' "$ROOT/scripts/foreman-guard" "$list")"
  FILE="$dir/.claude/settings.json" HOOK="$hook" OFF=0 MATCH="Bash" json_edit "$BAN_EDIT"
  FILE="$dir/.claude/settings.json" QA="$qa_home" PROJ="$PROJECT" PLUGINS="$(printf '%s\n' "${plugins[@]}")" json_edit '
    const add = (a, v) => (a.includes(v) ? a : a.concat([v]));
    j.permissions = j.permissions || {};
    j.permissions.deny = add(j.permissions.deny || [], "Read(/" + env.QA + "/**)");
    j.permissions.additionalDirectories = add(j.permissions.additionalDirectories || [], env.PROJ);
    for (const p of env.PLUGINS.split("\n").filter(Boolean)) (j.enabledPlugins = j.enabledPlugins || {})[p] = true;
    return j;'
  text="$(cat "$FRONT_TEMPLATE")"
  for k in "LEAD=$lead" "PROJECT=$PROJECT" "NAME=$SLUG"; do text="${text//"{{${k%%=*}}}"/"${k#*=}"}"; done
  printf '%s\n' "$text" >"$dir/CLAUDE.md"
  say "front seat for $RIG_NAME: $dir"
  say "  may message:  $lead (and no other seat)"
  say "  out of reach: the QA rig ($qa_rig), $qa_home, $ROOT/scripts/qa"
  say "  hands jobs over as files in $PROJECT/.foreman/inbox/"
  [ "${#plugins[@]}" -eq 0 ] || say "  plugins on in this folder: ${plugins[*]}"
  say ""
  say "Open that folder as a project in the app you run Claude Code in. This covers Claude Code only."
  say "Check it once: ask the session to read a file under $qa_home; it must be refused."
}

# --- builder task files ---------------------------------------------------------------------
# A builder task is all the builder knows, so what it must do and how it must report travel in
# the task file itself, not in its role. The skeleton comes from here; the owner fills it in;
# task-check refuses one that is not ready; result-check compares what came back with the task
# and with the checkout. The builder's typical miss is a rule nothing proves, reported as met,
# so rules are split into those the command proves and those checked by eye, the second kind is
# capped, and each of those must be answered with the file and line that meets it.
MAX_BY_EYE=3
WARN_RULES=10

task_paths() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] || die "the task number must be a number: ${1:-<none>}"
  TASK="$JOB_DIR/ctx/code-$1.task.md"; RESULT="$JOB_DIR/out/code-$1.md"; TASK_META="$JOB_DIR/ctx/code-$1.check.json"
}

# Lines of section "## $2" of file $1 (up to the next "## "), without HTML comments.
section() { awk -v h="## $2" '$0 == h {p=1; next} /^## / {p=0} p' "$1" | sed '/^<!--.*-->$/d'; }

cmd_task() {
  resolve "${1:-}"; job_dir "${2:-}"; task_paths "${3:-}"
  [ ! -e "$TASK" ] || die "$TASK already exists; edit it, or delete it to start again"
  mkdir -p "$JOB_DIR/ctx" "$JOB_DIR/out"
  cat >"$TASK" <<TASKEOF
# code-$3: FILL-ME a short title (job $JOB)

## Goal
FILL-ME: two or three plain sentences. What this piece does and why.

## Files you may change
<!-- one path per line, in backticks. The builder may change no other file. -->
- \`FILL-ME\`

## Rules the command proves
<!-- numbered from 1, one rule per line. The command below fails if one of these is broken. -->
1. FILL-ME

## Rules you check by eye
<!-- at most $MAX_BY_EYE, numbering continues. Nothing proves these, so each needs an example below. Write "none" if there are none. -->
FILL-ME

## Examples
<!-- for each check-by-eye rule: a line "Rule N:" and then the exact form wanted, two or three lines of code. Write "none" if there are no such rules. -->
FILL-ME

## Command that must pass
\`FILL-ME\`

## Your result
Write \`$RESULT\` in exactly this shape, then hand back.

\`\`\`
kind: code
status: done
command: <the command you ran>
result: <its last line>
files: <every file you changed, separated by spaces>
rule 1: command
rule 2: path/to/file.ts:14
notes: <anything the owner should know>
\`\`\`

- One \`rule N:\` line for every numbered rule above. No rule left out.
- For a rule the command proves, write \`command\`, and only if the command passed.
- For a check-by-eye rule, open the file and find the line where your code meets the rule. Write
  that file and line number. Look before you write it: a line you did not open is a guess.
- If you cannot point to the line, the rule is not met. Fix the code, or write \`status: stuck\`
  and say in \`notes\` which rule and why. "Stuck" is a good answer. A rule reported met that is
  not met is the worst one.
TASKEOF
  say "wrote $TASK"
  say "Fill in every FILL-ME, then run: $ROOT/scripts/foreman task-check \"$PROJECT\" $JOB $3"
}

# Numbered rule lines ("N. text") of section $1 in the task file, as "N<TAB>text".
rules_of() { section "$TASK" "$1" | sed -n 's/^\([0-9][0-9]*\)\.[[:space:]]\{1,\}\(.*\)$/\1\t\2/p'; }

cmd_task_check() {
  resolve "${1:-}"; job_dir "${2:-}"; task_paths "${3:-}"
  [ -f "$TASK" ] || die "no task file $TASK; create it with: scripts/foreman task \"$PROJECT\" $JOB $3"
  local problems=() warns=() files proved eye nums n want=1 ex cmd w
  # One copy is read for every check and for the digest, so the stored facts and the digest
  # describe the same text even if the file is edited meanwhile.
  tsnap="$(mktemp)"; trap 'rm -f "$tsnap"' EXIT   # not local: the trap runs after the function returns
  cp "$TASK" "$tsnap"; TASK="$tsnap"
  ! grep -q 'FILL-ME' "$TASK" || problems+=("$(grep -c 'FILL-ME' "$TASK") FILL-ME left in the file")
  [ -n "$(section "$TASK" Goal | tr -d '[:space:]')" ] || problems+=("the Goal is empty")
  files="$(section "$TASK" "Files you may change" | grep -o '`[^`]*`' | tr -d '`' | sort -u || true)"
  [ -n "$files" ] || problems+=("no file is named under 'Files you may change' (put each path in backticks)")
  [ "$(printf '%s\n' "$files" | grep -c . || true)" -le 3 ] || warns+=("more than three files: consider a smaller piece")
  proved="$(rules_of "Rules the command proves")"; eye="$(rules_of "Rules you check by eye")"
  [ -n "$proved$eye" ] || problems+=("no numbered rule")
  nums="$(printf '%s\n%s\n' "$proved" "$eye" | cut -f1 | grep . || true)"
  for n in $nums; do [ "$n" = "$want" ] || { problems+=("rules must be numbered 1, 2, 3 ... across both lists (found $n where $want was expected)"); break; }; want=$((want+1)); done
  n="$(printf '%s\n' "$eye" | grep -c . || true)"
  [ "$n" -le "$MAX_BY_EYE" ] || problems+=("$n check-by-eye rules; at most $MAX_BY_EYE. Turn the others into something the command proves (a test, a lint rule), or split the piece")
  if [ "$n" -gt 0 ]; then
    ex="$(section "$TASK" Examples)"
    for w in $(printf '%s\n' "$eye" | cut -f1 | grep . || true); do
      printf '%s\n' "$ex" | awk -v n="$w" '
          { l = tolower($0) }
          match(l, "^[^a-z0-9]*rule[ \t]+" n "[^0-9a-z]") { on = 1; rest = substr($0, RSTART + RLENGTH); if (rest ~ /[^[:space:]:*_`-]/) found = 1; next }
          l ~ /^[^a-z0-9]*rule[ \t]+[0-9]+[^0-9a-z]/ { on = 0; next }
          on && /[^[:space:]]/ { found = 1 }
          END { exit !found }' \
        || problems+=("check-by-eye rule $w needs its own example under Examples, starting \"Rule $w:\" (the exact form wanted)")
    done
  fi
  [ "$((want-1))" -le "$WARN_RULES" ] || warns+=("$((want-1)) rules in one piece: the builder misses more as the list grows; consider splitting")
  cmd="$(section "$TASK" "Command that must pass" | grep -o '`[^`]*`' | head -1 | tr -d '`' || true)"
  [ -n "$cmd" ] || problems+=("no command under 'Command that must pass' (put it in backticks)")
  grep -q '^## Your result$' "$TASK" && grep -q '^- One `rule N:` line for every numbered rule' "$TASK" || problems+=("the 'Your result' section from the skeleton is missing or was changed; it tells the builder how to report")
  for w in "${warns[@]}"; do say "note: $w"; done
  if [ "${#problems[@]}" -gt 0 ]; then
    say "task code-$3 is NOT ready:"; for w in "${problems[@]}"; do say "  - $w"; done; exit 1
  fi
  jq -n --argjson rules "$((want-1))" --argjson eye "$n" --arg files "$files" \
    --arg proved "$(printf '%s\n' "$proved" | cut -f1 | grep . | paste -sd' ' - || true)" --arg eyen "$(printf '%s\n' "$eye" | cut -f1 | grep . | paste -sd' ' - || true)" \
    --arg sum "$(sha256sum <"$TASK" | cut -d' ' -f1)" \
    '{rules:$rules, by_eye:$eye, task_sha256:$sum, files:($files | split("\n") | map(select(length > 0))),
      proved:($proved | split(" ") | map(select(length > 0) | tonumber)), eye:($eyen | split(" ") | map(select(length > 0) | tonumber))}' >"$TASK_META"
  say "task code-$3 is ready: $((want-1)) rules, $n checked by eye, $(printf '%s\n' "$files" | grep -c .) file(s)"
}

cmd_result_check() {
  resolve "${1:-}"; job_dir "${2:-}"; task_paths "${3:-}"
  [ -f "$TASK_META" ] || die "run task-check on this task first (no $TASK_META)"
  [ -f "$RESULT" ] || die "no result file $RESULT"
  [ -f "$TASK" ] && [ "$(jq -r '.task_sha256 // ""' "$TASK_META")" = "$(sha256sum <"$TASK" | cut -d' ' -f1)" ] \
    || die "the task file changed after task-check (or is gone), so the result cannot be checked against it. Run task-check again: scripts/foreman task-check \"$PROJECT\" $JOB $3"
  local status problems=() n ev f line changed extra
  status="$(sed -n 's/^status:[[:space:]]*\([a-z]*\).*/\1/p' "$RESULT" | head -1)"
  case "$status" in
    stuck) jq -n '{status:"stuck", ok:true, problems:[]}' >"$JOB_DIR/out/code-$3.check.json"; say "result code-$3: the builder says it is stuck. Read its notes."; return 0 ;;
    done) ;;
    *) problems+=("no 'status: done' or 'status: stuck' line") ;;
  esac
  for n in $(jq -r '.proved[], .eye[]' "$TASK_META"); do
    ev="$(sed -n "s/^rule $n:[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*$/\1/p" "$RESULT" | head -1)"
    if [ -z "$ev" ]; then problems+=("rule $n: no 'rule $n:' line"); continue; fi
    if jq -e --argjson n "$n" '.proved | index($n)' "$TASK_META" >/dev/null && [ "$ev" = command ]; then continue; fi
    [ "$ev" != command ] || { problems+=("rule $n: 'command' given, but nothing proves this rule; it needs a file and line"); continue; }
    f="${ev%:*}"; line="${ev##*:}"
    [[ "$ev" == *:* && "$line" =~ ^[0-9]+$ && "$line" -ge 1 ]] || { problems+=("rule $n: '$ev' is not a file and line (path/to/file:14)"); continue; }
    jq -e --arg f "$f" '.files | index($f)' "$TASK_META" >/dev/null || { problems+=("rule $n: $f is not one of the task's files"); continue; }
    [ -f "$PROJECT/$f" ] || { problems+=("rule $n: $f does not exist"); continue; }
    [ "$line" -le "$(awk 'END {print NR}' "$PROJECT/$f")" ] || problems+=("rule $n: $f has no line $line")
  done
  # Everything changed in the checkout must be one of the task's files.
  changed="$(git -C "$PROJECT" status --porcelain --untracked-files=all | sed 's/^...//; s/^.* -> //' | sort -u)"
  extra="$(printf '%s\n' "$changed" | grep . | grep -vxF -f <(jq -r '.files[]' "$TASK_META") || true)"
  [ -z "$extra" ] || problems+=("changed outside the task's files: $(printf '%s' "$extra" | paste -sd' ' -)")
  while IFS= read -r f; do
    printf '%s\n' "$changed" | grep -qxF "$f" || problems+=("$f is one of the task's files but is unchanged")
  done < <(jq -r '.files[]' "$TASK_META")
  jq -n --arg st "$status" --args '{status:$st, ok:($ARGS.positional | length == 0), problems:$ARGS.positional}' "${problems[@]}" >"$JOB_DIR/out/code-$3.check.json"
  if [ "${#problems[@]}" -gt 0 ]; then
    say "result code-$3 does NOT match its task:"; for n in "${problems[@]}"; do say "  - $n"; done
    say "This checks the report's form. Every rule is still yours to check in the code."; exit 1
  fi
  say "result code-$3 matches its task: every rule answered, only the task's files changed."
  say "This checks the report's form. Every rule is still yours to check in the code: open each cited line."
}

# --- retro and the lessons ledger -----------------------------------------------------------
# After each job a seat reads the job's ledger and logs up to three lessons: habits it saw, good
# or bad, each tied to the file that shows it. This only logs. No rule, prompt or code changes
# because of a lesson; a later audit reads the ledger and proposes changes for the human.
# The ledger is <project>/.foreman/habits.jsonl, one lesson per line.

HABIT_SEATS=(owner checker coder auditor qa crew)
MAX_LESSONS=3

job_dir() {
  [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] || die "not a job id: ${1:-<none>}"
  JOB="$1"; JOB_DIR="$PROJECT/.foreman/jobs/$JOB"
  [ -d "$JOB_DIR" ] || die "no job folder $JOB_DIR"
  LEDGER="$PROJECT/.foreman/habits.jsonl"
}

# The job's outcome numbers as one JSON object, counted from the job's own files and the QA rig's
# records. Counted in code so that no model has to remember them.
job_numbers() {
  local qa_home="${QA_HOME:-$HOME/.foreman-qa}" f blocks=0 passes=0 coder=0 stuck=0 qa_sent=0 sb=0 ov=0
  local verdicts=() issue cand d v began runs=" "
  # When the job began: the oldest file in its folder. Rows in shared logs count from then on.
  began="$(find "$JOB_DIR" -type f -printf '%T@\n' 2>/dev/null | sort -n | head -1 | cut -d. -f1)"
  began="$(date -u -d "@${began:-0}" +%FT%TZ)"
  for f in "$JOB_DIR"/out/*.md; do
    [ -f "$f" ] || continue
    case "$(head -n 12 "$f" | sed -n 's/^verdict:[[:space:]]*\(PASS\|BLOCK\).*/\1/p' | head -1)" in
      BLOCK) blocks=$((blocks+1)) ;; PASS) passes=$((passes+1)) ;;
    esac
    # A coder result starts with "status: done" or "status: stuck" (older jobs used code-* names for checker rounds).
    case "$(head -n 12 "$f" | sed -n 's/^status:[[:space:]]*\(done\|stuck\).*/\1/p' | head -1)" in
      done) coder=$((coder+1)) ;; stuck) coder=$((coder+1)); stuck=$((stuck+1)) ;;
    esac
  done
  # QA contracts the owner wrote for this job. A contract may never have been sent (a refused
  # send leaves the file behind), so this counts contracts, not sends.
  local issues=() seen=" " slug
  slug="$(basename "$PROJECT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-')"
  for f in "$JOB_DIR"/ctx/qa-r*.json; do
    [ -f "$f" ] && jq -e . "$f" >/dev/null 2>&1 || continue
    qa_sent=$((qa_sent+1)); issue="$(jq -r '.issue // ""' "$f")"; cand="$(jq -r '.candidate // ""' "$f")"
    for d in "$qa_home"/runs/*/; do
      [ -f "$d/verdict.json" ] && [ -f "$d/contract.json" ] || continue
      [ "$(jq -r '.issue + " " + .candidate' "$d/contract.json")" = "$issue $cand" ] || continue
      case "$runs" in *" $d "*) continue ;; esac; runs="$runs$d "     # a QA run counts once
      v="$(jq -r '.verdict + (if .gate then " at " + .gate else "" end)' "$d/verdict.json")"; verdicts+=("$v")
    done
    case "$seen" in *" $issue "*) ;; *) seen="$seen$issue "; [ -z "$issue" ] || issues+=("$issue") ;; esac
  done
  # Screener rows are counted once per job, however many QA rounds it had: each row whose issue
  # is one of this job's, whose repo is this project, and that was written since the job began.
  if [ -f "$qa_home/screener/log.jsonl" ] && [ "${#issues[@]}" -gt 0 ]; then
    sb="$(jq -c --arg r "$slug" --arg b "$began" --args 'select(.repo == $r and (.at // "") >= $b and .decision == "send_back" and (.issue as $i | $ARGS.positional | index($i)))' "${issues[@]}" <"$qa_home/screener/log.jsonl" 2>/dev/null | wc -l | tr -d ' ')"
    ov="$(jq -c --arg r "$slug" --arg b "$began" --args 'select(.repo == $r and (.at // "") >= $b and .decision == "overridden" and (.issue as $i | $ARGS.positional | index($i)))' "${issues[@]}" <"$qa_home/screener/log.jsonl" 2>/dev/null | wc -l | tr -d ' ')"
  fi
  # Builder task files made with `foreman task`: how many rules were given, how many had no
  # proof but the builder's eye, and how many results did not match their task.
  local t_rules=0 t_eye=0 t_bad=0
  for f in "$JOB_DIR"/ctx/code-*.check.json; do
    [ -f "$f" ] || continue
    t_rules=$((t_rules + $(jq -r '.rules // 0' "$f"))); t_eye=$((t_eye + $(jq -r '.by_eye // 0' "$f")))
  done
  for f in "$JOB_DIR"/out/code-*.check.json; do
    [ -f "$f" ] && [ "$(jq -r '.ok' "$f")" = false ] && t_bad=$((t_bad+1))
  done
  # Times the watcher nudged an idle builder, and times it gave up and told the owner, since
  # this job's folder got its first file.
  local nud=0 gave=0 stalls
  RIG_NAME="${RIG_NAME:-foreman-$SLUG}"; stalls="$(unstick_dir)/stalls.jsonl"
  if [ -f "$stalls" ]; then
    nud="$(jq -c --arg b "$began" 'select(.at >= $b and .nudge)' <"$stalls" 2>/dev/null | wc -l | tr -d ' ')"
    gave="$(jq -c --arg b "$began" 'select(.at >= $b and .told_owner)' <"$stalls" 2>/dev/null | wc -l | tr -d ' ')"
  fi
  jq -cn --argjson b "$blocks" --argjson p "$passes" --argjson c "$coder" --argjson s "$stuck" --argjson q "$qa_sent" \
        --argjson sb "$sb" --argjson ov "$ov" --argjson tr "$t_rules" --argjson te "$t_eye" --argjson tb "$t_bad" --argjson nu "$nud" --argjson gu "$gave" --args '{checker_blocks:$b, checker_passes:$p, coder_tasks:$c, coder_stuck:$s,
          coder_nudges:$nu, coder_gave_up:$gu,
          coder_rules:$tr, coder_rules_by_eye:$te, coder_results_not_matching:$tb,
          qa_contracts:$q, qa_verdicts:$ARGS.positional, screener_send_backs:$sb, screener_overruled:$ov}' "${verdicts[@]}"
}

cmd_retro() {
  resolve "${1:-}"; job_dir "${2:-}"
  local n task="$JOB_DIR/ctx/retro.task.md" me="$ROOT/scripts/foreman"
  n="$(job_numbers)"; printf '%s\n' "$n" >"$JOB_DIR/retro.json"
  mkdir -p "$JOB_DIR/ctx"
  {
    say "# Retro task for job $JOB"
    say ""
    say "Read this job's records and log up to $MAX_LESSONS lessons. A lesson is a habit you can see in"
    say "the records: something a seat did that cost a round, or something that worked and should be kept."
    say "You change nothing else: no code, no rule, no other file."
    say ""
    say "## Read"
    say "- \`$JOB_DIR/LOG.md\` and \`DECISIONS.md\` if they exist"
    say "- every file in \`$JOB_DIR/out/\` (the checker's verdicts, the coder's results, QA verdicts)"
    say "- the task files in \`$JOB_DIR/ctx/\` that those answer"
    say ""
    say "## How the job went, counted from its files"
    jq -r 'to_entries[] | "- \(.key | gsub("_"; " ")): \(.value | if type == "array" then (if length == 0 then "none" else join("; ") end) else tostring end)"' <<<"$n"
    say ""
    say "## Rules for a lesson"
    say "1. One sentence, 20 to 240 characters, on one line."
    say "2. It names a habit, not a one-off: \"the owner briefed the checker without saying what was untested\", not \"round 2 was slow\"."
    say "3. It names the seat it is about: ${HABIT_SEATS[*]}."
    say "4. It points at one file in this job's folder that shows it."
    say "5. No code, no names of people or customers, no data from the project. Describe the behavior only."
    say "6. If the records show nothing worth keeping, log nothing. Zero lessons is a fine result."
    say ""
    say "## Log each lesson with this command"
    say '```'
    say "$me lesson \"$PROJECT\" $JOB <seat> <file-in-the-job-folder> \"<the lesson>\""
    say '```'
    say "The command refuses a fourth lesson, a lesson with no evidence file, and a repeat."
    say ""
    say "## When done"
    say "Write \`$JOB_DIR/out/retro.md\` with one line: \`lessons: <how many you logged>\`. Then hand back."
  } >"$task"
  say "$n"
  say "retro task: $task"
}

cmd_lesson() {
  resolve "${1:-}"; job_dir "${2:-}"
  local about="${3:-}" ev="${4:-}" text="${5:-}" s ok=0 evp count
  [ $# -eq 5 ] || die "usage: scripts/foreman lesson <project> <job-id> <seat> <evidence-file> \"<lesson>\""
  for s in "${HABIT_SEATS[@]}"; do [ "$s" = "$about" ] && ok=1; done
  [ "$ok" -eq 1 ] || die "seat must be one of: ${HABIT_SEATS[*]}"
  [[ "$text" != *$'\n'* ]] || die "a lesson is one line"
  [ "${#text}" -ge 20 ] && [ "${#text}" -le 240 ] || die "a lesson is 20 to 240 characters (this one is ${#text})"
  case "$ev" in /*) evp="$ev" ;; *) evp="$JOB_DIR/$ev" ;; esac
  [ -f "$evp" ] || die "evidence file not found: $evp"
  evp="$(realpath -e -- "$evp")"   # links resolved all the way, so a link out of the job folder is refused
  case "$evp" in "$(cd "$JOB_DIR" && pwd -P)"/*) ;; *) die "the evidence file must be inside the job folder $JOB_DIR" ;; esac
  touch "$LEDGER"
  count="$(jq -c --arg j "$JOB" 'select(.job == $j)' "$LEDGER" | wc -l)"
  [ "$count" -lt "$MAX_LESSONS" ] || die "job $JOB already has $MAX_LESSONS lessons; that is the cap"
  ! jq -e --arg j "$JOB" --arg t "$text" 'select(.job == $j and .lesson == $t)' "$LEDGER" >/dev/null || die "that lesson is already logged for $JOB"
  jq -cn --arg at "$(date -u +%FT%TZ)" --arg j "$JOB" --arg a "$about" --arg t "$text" \
        --arg e "${evp#"$(cd "$JOB_DIR" && pwd -P)"/}" --arg by "${OPENRIG_SESSION_NAME:-unknown}" \
        --slurpfile n <(cat "$JOB_DIR/retro.json" 2>/dev/null || echo null) \
    '{at:$at, job:$j, about:$a, lesson:$t, evidence:$e, by:$by, numbers:$n[0]}' >>"$LEDGER"
  say "logged lesson $((count+1)) of $MAX_LESSONS for $JOB"
}

cmd_habits() {
  resolve "${1:-}"
  local ledger="$PROJECT/.foreman/habits.jsonl"
  [ -s "$ledger" ] || { say "no lessons logged yet ($ledger)"; return; }
  jq -r '"\(.at[0:10])  \(.job)  [\(.about)]  \(.lesson)  (\(.evidence))"' "$ledger"
  say ""
  say "$(wc -l <"$ledger" | tr -d ' ') lessons from $(jq -r .job "$ledger" | sort -u | wc -l | tr -d ' ') jobs"
}

# --- main ---------------------------------------------------------------------------------

cmd="${1:-}"; shift || true
case "$cmd" in
  init)  cmd_init "$@" ;;
  check) cmd_check "$@" ;;
  up)    cmd_up "$@" ;;
  down)  cmd_down "$@" ;;
  tracing) cmd_tracing "$@" ;;
  unstick) cmd_unstick "$@" ;;
  bans) cmd_bans "$@" ;;
  front) cmd_front "$@" ;;
  task) cmd_task "$@" ;;
  task-check) cmd_task_check "$@" ;;
  result-check) cmd_result_check "$@" ;;
  retro) cmd_retro "$@" ;;
  lesson) cmd_lesson "$@" ;;
  habits) cmd_habits "$@" ;;
  *)     usage ;;
esac
